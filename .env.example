# ==============================================================================
# AI Code Review Bot - Environment Variables Template
# ==============================================================================
# Copy this file to .env and configure values before starting the application:
#   cp .env.example .env
#
# SECURITY WARNING:
# - NEVER commit real credentials, tokens, or private keys to source control.
# - The .env file and secrets/ directory are gitignored.
# - In production (SPRING_PROFILES_ACTIVE=prod), the backend strictly validates
#   that secrets are not blank and do not use insecure dev default placeholders.
# ==============================================================================

# --- Application Profile & Networking ---
# Use 'dev' for local developer machines; use 'prod' for production environments.
SPRING_PROFILES_ACTIVE=dev
PORT=8080
FRONTEND_PORT=5173

# --- Database Configuration (PostgreSQL) ---
# For local non-Docker development: DB_HOST=127.0.0.1
# For Docker Compose: DB_HOST=postgres (matches internal service name)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=code_review_bot
DB_USERNAME=postgres
DB_PASSWORD=postgres
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/code_review_bot
# Connection Pool Tuning (HikariCP)
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=5
DB_POOL_CONNECTION_TIMEOUT_MS=30000

# --- Frontend API Routing ---
# In Docker Compose, Nginx reverse-proxies /api/v1/ to the backend service.
# For standalone Vite dev server (npm run dev outside Docker), use http://localhost:8080/api/v1
VITE_API_BASE_URL=/api/v1

# --- JWT Security Configuration ---
# CRITICAL: In production, generate a cryptographically strong secret of at least 32 bytes:
# Example command: openssl rand -base64 32
JWT_SECRET=defaultDevSecretKeyThatIsAtLeast32BytesLongForHMACSHA256Signatures12345
JWT_EXPIRATION_MS=3600000
JWT_TOKEN_TYPE=Bearer
JWT_ISSUER=ai-code-review-bot

# --- GitHub App Integration ---
# Register a GitHub App under GitHub Settings -> Developer settings -> GitHub Apps
GITHUB_APP_ID=4642046
GITHUB_APP_NAME=Pushkar-AI-Code-Review-Bot
# Supply private key either as mounted PEM file path OR direct PEM string:
# Option A (Recommended): Place PEM file in ./secrets/github-app-private-key.pem
GITHUB_PRIVATE_KEY_PATH=/app/secrets/github-app-private-key.pem
# Option B: Pass PEM directly as an environment variable (escaped newlines):
GITHUB_PRIVATE_KEY=
# CRITICAL: Set a strong random secret and configure the identical secret in your GitHub App settings
GITHUB_WEBHOOK_SECRET=defaultWebhookSecret123
GITHUB_API_BASE_URL=https://api.github.com

# --- Google Gemini AI Integration ---
# Obtain your API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com

# --- Webhook Retry & Operations Configuration ---
WEBHOOK_RETRY_MAX_ATTEMPTS=3
WEBHOOK_RETRY_INITIAL_INTERVAL_MS=60000
WEBHOOK_RETRY_MULTIPLIER=2.0
WEBHOOK_RETRY_STALE_THRESHOLD_MS=300000
WEBHOOK_RETRY_SCHEDULER_ENABLED=false
WEBHOOK_RETRY_SCHEDULER_FIXED_DELAY_MS=60000
